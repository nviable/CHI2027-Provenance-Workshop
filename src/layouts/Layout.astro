---
import '../styles/global.css';
import { siteData } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = siteData.description,
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteData.title} · ${siteData.eventBadge}`
  : `${siteData.title} · ${siteData.eventBadge}`;

function isActive(href: string): boolean {
  const cleanCurrent = currentPath.replace(/\/+$/, '') || '/';
  const cleanHref = href.replace(/\/+$/, '') || '/';
  return cleanCurrent === cleanHref;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={siteData.ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Open+Sans:ital,wght@0,400;0,600;0,700;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- Reusable "pen wobble" filter for the hand-drawn sketches -->
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <filter id="pen">
        <feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3" />
        <feDisplacementMap in="SourceGraphic" scale="2.2" />
      </filter>
    </svg>

    <div class="topbar">
      <div class="wrap">
        <a class="wordmark" href="/">
          <svg viewBox="0 0 26 26" aria-hidden="true">
            <circle cx="13" cy="13" r="11.5" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path
              d="M8 13.5l3.3 3.3L18.5 9"
              fill="none"
              stroke="var(--blue)"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          {siteData.shortTitle}
          <small>{siteData.eventBadge}</small>
        </a>
        <a class="chi" href={siteData.conference.url} target="_blank" rel="noopener noreferrer">
          {siteData.conference.name} ↗
        </a>
      </div>
    </div>

    <nav class="tabs" aria-label="Primary navigation">
      <div class="wrap">
        <ul>
          {
            siteData.navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>

    <main id="main-content">
      <slot />
    </main>

    <footer>
      <div class="wrap">
        <div>
          <strong style="color:var(--ink)">{siteData.title}</strong> · a workshop at{' '}
          <a href={siteData.conference.url} target="_blank" rel="noopener noreferrer">
            {siteData.conference.name}
          </a>{' '}
          · {siteData.conference.location}
        </div>
        <div class="footer-links">
          <a href="/cfp">Call for Participation</a>
          <a href="/programme">Programme</a>
          <a href="/contact">Contact organizers</a>
          <span>
            Lead:{' '}
            <a href={`mailto:${siteData.leadContact.email}`}>{siteData.leadContact.name}</a>
          </span>
        </div>
      </div>
    </footer>
  </body>
</html>
