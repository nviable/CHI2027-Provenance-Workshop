---
import '../styles/global.css';
import { siteData } from '../lib/content';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
}

const {
  title,
  description = siteData.description,
  currentPath = Astro.url.pathname,
} = Astro.props;

const pageTitle = title
  ? `${title} · ${siteData.title} · ${siteData.eventBadge}`
  : `${siteData.title} · ${siteData.eventBadge}`;

function isActive(href: string): boolean {
  const cleanCurrent = currentPath.replace(/\/+$/, '') || '/';
  const cleanHref = href.replace(/\/+$/, '') || '/';
  return cleanCurrent === cleanHref;
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/assets/illustrations/hero-risograph.jpg" />
    <link rel="icon" type="image/svg+xml" href="/assets/logo.svg" />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="apple-touch-icon" href="/assets/logo@4x.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:ital,wght@0,500;0,600;0,700;0,800;1,500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>

    <!-- 6-color risograph pigment ribbon derived from logo.svg -->
    <div class="pigment-ribbon" aria-hidden="true">
      <span style="background:var(--coral)"></span>
      <span style="background:var(--tangerine)"></span>
      <span style="background:var(--gold)"></span>
      <span style="background:var(--emerald)"></span>
      <span style="background:var(--cerulean)"></span>
      <span style="background:var(--indigo)"></span>
    </div>

    <header class="site-header">
      <div class="wrap site-header-inner">
        <a class="brand" href="/">
          <img
            class="brand-mark"
            src="/assets/logo.svg"
            alt=""
            width="38"
            height="38"
          />
          <span class="brand-text">
            <strong>{siteData.title}</strong>
            <small>{siteData.eventBadge} · {siteData.conference.location}</small>
          </span>
        </a>

        <a
          class="chi-pill"
          href={siteData.conference.url}
          target="_blank"
          rel="noopener noreferrer"
        >
          <span>{siteData.conference.name}</span>
          <span aria-hidden="true">↗</span>
        </a>
      </div>

      <nav class="nav-strip" aria-label="Primary navigation">
        <div class="wrap">
          <ul>
            {
              siteData.navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </header>

    <main id="main-content">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap footer-inner">
        <div class="footer-brand">
          <img
            src="/assets/logo-bw.svg"
            alt=""
            width="34"
            height="34"
            class="footer-logo"
          />
          <div>
            <strong>{siteData.title}</strong>
            <div class="footer-sub">
              A workshop at{' '}
              <a href={siteData.conference.url} target="_blank" rel="noopener noreferrer">
                {siteData.conference.name}
              </a>{' '}
              · {siteData.conference.dates} · {siteData.conference.location}
            </div>
          </div>
        </div>

        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/">Overview</a>
          <a href="/cfp">Call for Participation</a>
          <a href="/programme">Programme</a>
          <a href="/organizers">Organizers</a>
          <a href="/venue-resources">Venue &amp; Resources</a>
          <a href="/contact">Contact</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
