---
import Layout from '../layouts/Layout.astro';
import ProvenanceDemo from '../components/ProvenanceDemo.tsx';
import PipelineInteractive from '../components/PipelineInteractive.tsx';
import FigureGallery from '../components/FigureGallery.tsx';
import WildMockups from '../components/WildMockups.astro';
import { homeData, renderInlineMarkdown, siteData } from '../lib/content';

const factDotColors = ['#dc5847', '#f0983d', '#409268', '#3380d8'];
---

<Layout currentPath="/">
  <header class="hero-banner" id="top">
    <img
      class="hero-bg-art"
      src="/assets/illustrations/hero-risograph.jpg"
      alt=""
      aria-hidden="true"
      width="1376"
      height="768"
      fetchpriority="high"
    />
    <div class="hero-dot-accent" aria-hidden="true"></div>

    <div class="wrap hero-stage">
      <div class="hero-content">
        <div class="hero-eyebrow">
          <span class="hero-eyebrow-dots" aria-hidden="true">
            <i style="background:var(--coral)"></i>
            <i style="background:var(--gold)"></i>
            <i style="background:var(--emerald)"></i>
            <i style="background:var(--cerulean)"></i>
          </span>
          <span>{siteData.conference.name} Workshop · {siteData.conference.location}</span>
        </div>

        <h1>{siteData.title}</h1>
        <p class="hero-tagline">{siteData.tagline}</p>

        <div class="btns">
          <a class="btn primary" href="/cfp">Call for participation →</a>
          <a class="btn secondary" href="/programme">View programme</a>
          {
            siteData.proposalPdf.url ? (
              <a
                class="btn secondary"
                href={siteData.proposalPdf.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {siteData.proposalPdf.label}
              </a>
            ) : null
          }
        </div>
      </div>

      <img
        class="hero-mobile-art riso-art"
        src="/assets/illustrations/hero-risograph.jpg"
        alt="Risograph illustration of a golden Pittsburgh bridge, magnifying glass, photo with provenance pin, and six-color aperture petals"
        width="1376"
        height="768"
      />
    </div>

    <div class="facts-strip">
      <div class="wrap">
        <div class="facts">
          {
            siteData.facts.map((fact, idx) => (
              <div class="fact-item">
                <span class="fact-label">
                  <span
                    class="fact-dot"
                    style={`background:${factDotColors[idx % factDotColors.length]}`}
                    aria-hidden="true"
                  />
                  {fact.label}
                </span>
                <b>
                  {fact.value}
                  {fact.note ? <span class="tba"> · {fact.note}</span> : null}
                </b>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </header>

  <section id="about">
    <div class="wrap">
      <div class="kicker">{homeData.overview.kicker}</div>
      <h2>{homeData.overview.heading}</h2>

      <div class="split top" style="margin-top:22px">
        <div>
          {
            homeData.overview.paragraphs.map((paragraph) => (
              <p class="lede" set:html={renderInlineMarkdown(paragraph)} />
            ))
          }
        </div>
        <ProvenanceDemo
          client:load
          imageUrl={homeData.demo.imageUrl}
          imageAlt={homeData.demo.imageAlt}
          meta={homeData.demo.meta}
          caption={homeData.demo.caption}
          states={homeData.demo.states}
        />
      </div>

      <PipelineInteractive client:visible pipeline={homeData.pipeline} />

      <div class="findings">
        {
          homeData.findings.map((finding) => (
            <div class="finding">
              <h3>{finding.title}</h3>
              <p>{finding.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="gallery" class="band">
    <div class="wrap">
      <div class="kicker">{homeData.gallery.kicker}</div>
      <h2>{homeData.gallery.heading}</h2>
      <p class="lede" style="margin-top:14px">{homeData.gallery.lede}</p>

      <WildMockups scenarios={homeData.gallery.scenarios} />

      <FigureGallery client:visible figures={homeData.gallery.figures} />
    </div>
  </section>

  <section id="questions">
    <div class="wrap">
      <div class="kicker">{homeData.questions.kicker}</div>
      <h2>{homeData.questions.heading}</h2>
      <p
        class="lede"
        style="margin-top:14px"
        set:html={renderInlineMarkdown(homeData.questions.lede)}
      />

      <div class="rqs">
        {
          homeData.questions.items.map((rq) => (
            <div class="rq">
              <div class="id">{rq.id}</div>
              <div class="nm">{rq.name}</div>
              <p>{rq.question}</p>
            </div>
          ))
        }
      </div>

      <div class="callout">
        <strong>{homeData.questions.privacyCallout.lead}</strong>{' '}
        {homeData.questions.privacyCallout.body}
      </div>

      <h3 style="margin-top:48px;font-size:22px">{homeData.questions.outcomesHeading}</h3>
      <ol class="outcomes">
        {homeData.questions.outcomes.map((outcome) => <li>{outcome}</li>)}
      </ol>
    </div>
  </section>

  <div class="next-step-band">
    <div class="wrap next-step-inner">
      <div>
        <h2>Ready to participate?</h2>
        <p>
          Explore the call for position papers and practice statements, or review the workshop
          schedule.
        </p>
      </div>
      <div class="btns">
        <a class="btn primary" href="/cfp">Call for Participation →</a>
        <a class="btn secondary" href="/programme">Programme</a>
        <a class="btn secondary" href="/contact">Contact us</a>
      </div>
    </div>
  </div>
</Layout>
