---
import Layout from '../layouts/Layout.astro';
import ProvenanceDemo from '../components/ProvenanceDemo.tsx';
import FigureGallery from '../components/FigureGallery.tsx';
import WildMockups from '../components/WildMockups.astro';
import { homeData, renderInlineMarkdown, siteData } from '../lib/content';
---

<Layout currentPath="/">
  <header class="hero" id="top">
    <div class="wrap">
      <!-- Hand-drawn hero sketch: mint blob, phone with provenance pin, magnifier, thought bubble -->
      <div class="art">
        <svg
          class="sketch"
          viewBox="0 0 640 260"
          role="img"
          aria-label="Line sketch: a person's hand holds a phone showing a photo with a provenance pin, wondering where it came from"
        >
          <path
            class="blob"
            d="M330 260 C 300 170 360 70 450 30 C 540 -8 640 10 640 10 V260 Z"
          />
          <g
            fill="none"
            stroke="currentColor"
            stroke-width="1.6"
            stroke-linecap="round"
            stroke-linejoin="round"
            filter="url(#pen)"
          >
            <!-- provenance trail -->
            <circle cx="70" cy="200" r="9" />
            <circle cx="150" cy="170" r="9" />
            <circle cx="230" cy="196" r="9" stroke-dasharray="3 4" />
            <path d="M79 197 Q 110 180 141 172" />
            <path d="M159 173 Q 190 182 221 193" stroke-dasharray="4 5" />
            <path d="M66 200 l3 3 6-6" />
            <!-- phone -->
            <g transform="rotate(-14 440 140)">
              <rect x="380" y="40" width="120" height="200" rx="16" />
              <rect x="392" y="64" width="96" height="70" rx="4" />
              <path d="M396 128 l22 -26 16 16 14 -12 36 22" />
              <circle cx="470" cy="80" r="7" />
              <rect x="398" y="70" width="40" height="13" rx="6.5" fill="var(--bg)" />
              <path d="M403 76.5 l2.5 2.5 4.5 -5" />
              <line x1="394" y1="148" x2="486" y2="148" />
              <line x1="394" y1="160" x2="466" y2="160" />
              <line x1="394" y1="172" x2="476" y2="172" />
              <rect x="394" y="186" width="44" height="34" rx="3" />
              <line x1="446" y1="192" x2="486" y2="192" />
              <line x1="446" y1="204" x2="478" y2="204" />
            </g>
            <!-- hand -->
            <path d="M520 236 C 506 214 496 196 502 178 C 506 166 520 166 524 178 L 534 206" />
            <path d="M534 206 C 546 196 560 200 566 214 L 590 260" />
            <path d="M486 248 C 480 238 486 228 498 232" />
            <!-- magnifier -->
            <circle cx="300" cy="96" r="30" />
            <path d="M321 117 l26 26" />
            <path d="M286 96 l9 9 18-18" />
            <!-- thought bubble -->
            <path
              d="M150 40 C 140 20 170 8 186 20 C 200 4 236 8 238 26 C 262 24 270 50 252 60 C 260 78 230 90 214 80 C 200 96 166 90 166 76 C 140 80 130 54 150 40 Z"
            />
            <circle cx="252" cy="92" r="5" />
            <circle cx="266" cy="104" r="3" />
          </g>
          <text class="hand" x="164" y="46" style="font-size:20px">where did</text>
          <text class="hand" x="150" y="68" style="font-size:20px">this come from?</text>
        </svg>
      </div>

      <div>
        <h1>{siteData.title}</h1>
        <p class="tagline">{siteData.tagline}</p>
        <div class="btns">
          <a class="btn primary" href="/cfp">Call for participation</a>
          {
            siteData.proposalPdf.url ? (
              <a
                class="btn secondary"
                href={siteData.proposalPdf.url}
                target="_blank"
                rel="noopener noreferrer"
              >
                {siteData.proposalPdf.label}
              </a>
            ) : (
              <span class="btn muted-disabled" title="Add proposal PDF URL in src/data/site.yaml">
                {siteData.proposalPdf.comingSoonNote}
              </span>
            )
          }
          <a class="btn secondary" href="/programme">View programme</a>
        </div>
      </div>

      <div class="facts">
        {
          siteData.facts.map((fact) => (
            <div>
              {fact.label}
              <b>
                {fact.value}
                {fact.note ? <span class="tba"> · {fact.note}</span> : null}
              </b>
            </div>
          ))
        }
      </div>
    </div>
  </header>

  <section id="about">
    <div class="wrap">
      <div class="kicker">{homeData.overview.kicker}</div>
      <h2>{homeData.overview.heading}</h2>

      <div class="split top" style="margin-top:18px">
        <div>
          {
            homeData.overview.paragraphs.map((paragraph) => (
              <p class="lede" set:html={renderInlineMarkdown(paragraph)} />
            ))
          }
        </div>
        <ProvenanceDemo
          client:load
          imageUrl={homeData.demo.imageUrl}
          imageAlt={homeData.demo.imageAlt}
          meta={homeData.demo.meta}
          caption={homeData.demo.caption}
          states={homeData.demo.states}
        />
      </div>

      <div class="pipeline" role="img" aria-label={homeData.pipeline.ariaLabel}>
        <div class="pl-head">
          <span>{homeData.pipeline.leftHeading}</span>
          <span class="last">{homeData.pipeline.rightHeading}</span>
        </div>
        <div class="stages">
          {
            homeData.pipeline.stages.map((stage) => (
              <div class={`stage${stage.lastMile ? ' lm' : ''}`}>
                <div class="n">{stage.number}</div>
                <h3>{stage.title}</h3>
                <p>{stage.description}</p>
              </div>
            ))
          }
        </div>
        <p class="chips">
          {homeData.pipeline.summaryPrefix}{' '}
          <span class="chip v"><i>✓</i>valid</span>,{' '}
          <span class="chip p"><i>◐</i>partial</span>,{' '}
          <span class="chip m"><i>○</i>missing</span> or{' '}
          <span class="chip c"><i>≠</i>conflicting</span>.
        </p>
      </div>

      <div class="findings">
        {
          homeData.findings.map((finding) => (
            <div class="finding">
              <h3>{finding.title}</h3>
              <p>{finding.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section id="gallery" class="band">
    <div class="wrap">
      <div class="kicker">{homeData.gallery.kicker}</div>
      <h2>{homeData.gallery.heading}</h2>
      <p class="lede" style="margin-top:14px">{homeData.gallery.lede}</p>

      <WildMockups scenarios={homeData.gallery.scenarios} />

      <FigureGallery client:visible figures={homeData.gallery.figures} />
    </div>
  </section>

  <section id="questions">
    <div class="wrap">
      <div class="kicker">{homeData.questions.kicker}</div>
      <h2>{homeData.questions.heading}</h2>
      <p
        class="lede"
        style="margin-top:14px"
        set:html={renderInlineMarkdown(homeData.questions.lede)}
      />

      <div class="rqs">
        {
          homeData.questions.items.map((rq) => (
            <div class="rq">
              <div class="id">{rq.id}</div>
              <div class="nm">{rq.name}</div>
              <p>{rq.question}</p>
            </div>
          ))
        }
      </div>

      <div class="callout">
        <strong>{homeData.questions.privacyCallout.lead}</strong>{' '}
        {homeData.questions.privacyCallout.body}
      </div>

      <h3 style="margin-top:48px;font-size:22px">{homeData.questions.outcomesHeading}</h3>
      <ol class="outcomes">
        {homeData.questions.outcomes.map((outcome) => <li>{outcome}</li>)}
      </ol>
    </div>
  </section>

  <div class="next-step-band">
    <div class="wrap next-step-inner">
      <div>
        <h2>Ready to participate?</h2>
        <p>
          Explore the call for position papers and practice statements, or review the workshop
          schedule.
        </p>
      </div>
      <div class="btns">
        <a class="btn primary" href="/cfp">Call for Participation</a>
        <a class="btn secondary" href="/programme">Programme</a>
        <a class="btn secondary" href="/contact">Contact us</a>
      </div>
    </div>
  </div>
</Layout>
