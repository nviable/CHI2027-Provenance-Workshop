---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page not found" currentPath="/404">
  <section style="padding:84px 0">
    <div class="wrap">
      <div class="kicker">404 · Missing provenance</div>
      <h1>We couldn't find that page</h1>
      <p class="lede" style="margin-top:14px">
        The link may have moved when we expanded the workshop site into multiple pages.
      </p>
      <div class="btns" style="margin-top:24px">
        <a class="btn primary" href="/">Back to Overview</a>
        <a class="btn secondary" href="/cfp">Call for Participation</a>
        <a class="btn secondary" href="/contact">Contact us</a>
      </div>
    </div>
  </section>
</Layout>
